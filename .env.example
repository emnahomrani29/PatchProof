# Copier ce fichier en .env et remplacer les valeurs. Ne jamais committer .env.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
MODELE_ATTAQUANT=anthropic/claude-sonnet-5.5
MODELE_DEFENSEUR=anthropic/claude-sonnet-5.5
MODELE_LEGER=anthropic/claude-haiku-5.5

# --- Limites par défaut (modifiables ensuite par l'administrateur) ---
BUDGET_JETONS_ANALYSE=400000
MAX_TENTATIVES_AGENT=3
MAX_APPELS_OUTILS_FAILLE=30

# --- Sécurité de l'application ---
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=a-remplacer
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLE_CHIFFREMENT=a-remplacer

# --- GitHub OAuth (https://github.com/settings/developers) ---
# URL de rappel à déclarer : http://localhost:8000/api/auth/github/retour
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Infrastructure (valeurs adaptées à docker compose) ---
DATABASE_URL=postgresql+psycopg://patchproof:patchproof@postgres:5432/patchproof
REDIS_URL=redis://redis:6379/0
URL_FRONTEND=http://localhost:5173
IMAGE_SANDBOX=patchproof-sandbox:latest
